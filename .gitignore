Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================================================
# Project Specific
# ============================================================================
# Database files (keep test databases out)
*.db
*.sqlite
*.sqlite3
test_crimeshield.db
crimeshield.db

# Generated reports (keep examples but not all)
reports/*.csv
reports/*.txt
!reports/.gitkeep

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# ============================================================================
# Node.js / Frontend (if applicable)
# ============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Compiled output
dist/
dist-ssr/
*.local

# Frontend build artifacts
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Testing
frontend/coverage/

# Production
frontend/build/

# Misc
.DS_Store
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ============================================================================
# Secrets and Credentials
# ============================================================================
# Never commit these!
.env
.env.local
.env.*.local
*.key
*.pem
*.cert
secrets.json
credentials.json
config.local.py

# ============================================================================
# Documentation Build
# ============================================================================
docs/_build/
docs/_static/
docs/_templates/

# ============================================================================
# Backup files
# ============================================================================
*.backup
*.old
*.orig

# ============================================================================
# Keep these files
# ============================================================================
!.gitignore
!.gitkeep
!README.md
